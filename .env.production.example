# Copy to .env.production on the deployment host. Do not commit the copied file.
POSTGRES_USER=fabbi
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_DB=fabbi
REDIS_PASSWORD=replace-with-a-long-random-value
DATABASE_URL=postgresql+asyncpg://fabbi:replace-with-url-encoded-postgres-password@postgres:5432/fabbi
REDIS_URL=redis://:replace-with-url-encoded-redis-password@redis:6379/0
JWT_SECRET=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
VITE_API_URL=https://api.example.com
FRONTEND_PORT=3000
